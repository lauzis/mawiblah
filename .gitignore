# vendor/ is built rather than committed: composer install on deploy.
# The plugin refuses to load without it and says so, rather than fataling.
# composer.lock stays in git, so that install resolves what was tested.
/vendor/

# node_modules/ is the same: `npm install` brings jest back when the JS tests
# need running. package-lock.json stays, so it brings back what was tested.
/node_modules/

.idea
/mailchimp_audience/
/email_templates/archieved
/email_templates/archived
/plugin-guidelines/
Todo.md

# PHPUnit writes this beside the config when the suite runs.
.phpunit.result.cache
