{
  "name": "mawiblah/mawiblah",
  "description": "Mawiblah WordPress email campaign plugin",
  "type": "wordpress-plugin",
  "license": "GPL-3.0",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/lauzis/wp-logs"
    }
  ],
  "require": {
    "lauzis/wp-logs": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "wp-phpunit/wp-phpunit": "^6"
  },
  "autoload-dev": {
    "psr-4": {
      "Mawiblah\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
